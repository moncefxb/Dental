+@media (max-width: 820px) {
+  .service-detail-list .service-detail-card {
+    grid-template-columns: 38px minmax(0, 1fr);
+    grid-template-areas:
+      "no copy"
+      "icon copy"
+      "aside aside";
+    gap: 10px 16px;
+    padding: 22px;
+  }
+
+  .service-detail-list .service-detail-aside {
+    display: flex;
+    flex-direction: row;
+    align-items: center;
+    justify-content: space-between;
+    gap: 14px;
+    margin-top: 8px;
+    padding-top: 13px;
+    border-top: 1px solid var(--line);
+    text-align: start;
+  }
+
+  .service-detail-list .service-detail-copy h3 {
+    font-size: clamp(19px, 3.2vw, 23px);
+    line-height: 1.5;
+  }
+
+  .service-detail-list .service-detail-copy p {
+    font-size: 12px;
+    line-height: 2;
+  }
+}
+
+@media (max-width: 560px) {
+  .service-detail-list { gap: 12px; }
+
+  .service-detail-list .service-detail-card {
+    grid-template-columns: 32px minmax(0, 1fr);
+    gap: 9px 12px;
+    padding: 18px;
+    border-radius: 16px;
+  }
+
+  .service-detail-list .service-detail-no {
+    padding-top: 4px;
+    font-size: 10px;
+  }
+
+  .service-detail-list .service-detail-icon {
+    align-self: start;
+    font-size: 23px;
+  }
+
+  .service-detail-list .service-detail-copy h3 {
+    margin: 0 0 8px;
+    font-size: 19px;
+    line-height: 1.55;
+  }
+
+  .service-detail-list .service-detail-copy p { font-size: 11px; }
+  .service-detail-list .service-detail-copy ul { gap: 7px 12px; margin-top: 12px; }
+  .service-detail-list .service-detail-copy li { font-size: 10px; }
+  .service-detail-list .service-detail-aside { font-size: 9px; }
+}
+
+/* Touchscreens: scroll-reveal motion remains active; pressing a card gives brief feedback. */
+@media (hover: none), (pointer: coarse) {
+  .service-detail-list .service-detail-card:active {
+    translate: 0 -2px;
+    background-color: rgba(255, 255, 255, 0.78);
+    box-shadow: 0 9px 24px rgba(23, 45, 53, 0.09);
+  }
+
+  .service-detail-list .service-detail-card:active .service-detail-icon {
+    color: var(--rust);
+    transform: translateY(-2px) scale(1.04);
+  }
+}
+
 @media (prefers-reduced-motion: reduce) {
-  .service-detail-list .service-detail-card:hover {
+  .service-detail-list .service-detail-card,
+  .service-detail-list .service-detail-card:hover,
+  .service-detail-list .service-detail-card:active {
     translate: none !important;
   }
 
-  .service-detail-list .service-detail-card:hover .service-detail-icon {
+  .service-detail-list .service-detail-card:hover .service-detail-icon,
+  .service-detail-list .service-detail-card:active .service-detail-icon {
     transform: none !important;
   }
 }
