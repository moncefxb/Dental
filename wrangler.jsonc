{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "dental",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dental",
      "database_id": "aefb7588-9780-476a-8869-94ea96135b3c"
    }
  ]
}
