# Copy to wrangler.local.toml and replace database_id with your D1 database UUID.
# This config is for local Pages + D1 development only.
name = "nova-dental-local"
pages_build_output_dir = "."
compatibility_date = "2026-11-19"

[[d1_databases]]
binding = "DB"
database_name = "nova-dental-db"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"
preview_database_id = "DB"
migrations_dir = "migrations"
